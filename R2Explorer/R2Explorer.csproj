<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>R2Explorer</RootNamespace>
    <AssemblyName>R2Explorer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>R2Explorer</Product>
    <Description>Cloudflare R2 对象存储图形化客户端（S3 兼容）</Description>
    <Authors>R2Explorer</Authors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.7.401.2" />
  </ItemGroup>

  <!-- 将图标打包为 WPF Resource，供 XAML 中 Icon="Resources/app.ico" 运行时加载 -->
  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <!-- UseWindowsForms=true 会隐式注入 System.Drawing / System.Windows.Forms 全局 using，与 WPF 类型冲突，显式移除，仅在需要的文件局部引入 -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
