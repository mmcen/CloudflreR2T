<Window x:Class="R2Explorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:R2Explorer.Models"
        xmlns:conv="clr-namespace:R2Explorer.Converters"
        mc:Ignorable="d"
        Title="R2 Explorer - Cloudflare R2 客户端"
        Width="1240" Height="780" MinWidth="1000" MinHeight="620"
        Background="{DynamicResource WindowBgBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <conv:FolderIconConverter x:Key="FolderIcon" />
        <conv:TransferStateToColorConverter x:Key="TransferStateColor" />

        <!-- 帐号卡片模板 -->
        <DataTemplate x:Key="AccountCardTemplate">
            <Grid Margin="12,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34"
                        Background="{DynamicResource AccentDimBrush}"
                        CornerRadius="8" Margin="0,0,10,0">
                    <TextBlock Text="&#xE7C1;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding ModeLabel}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding EndpointLabel}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 对象列表图标模板 -->
        <DataTemplate x:Key="NameCellTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding IsFolder, Converter={StaticResource FolderIcon}}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="4,0,8,0" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 主区域 ================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="260" MaxWidth="460" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左侧：资产 / 帐号管理 ============ -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <StackPanel Grid.Row="0" Margin="16,16,16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="R2" Foreground="{DynamicResource AccentBrush}" FontSize="24" FontWeight="Bold" />
                            <TextBlock Text="EXPLORER" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="Cloudflare R2 对象存储客户端"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- 帐号列表 -->
                    <Grid Grid.Row="1" Margin="8,4,8,0">
                        <ListBox x:Name="AccountList"
                                 ItemTemplate="{StaticResource AccountCardTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="AccountList_SelectionChanged" />

                        <Border x:Name="NoAccountOverlay" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="暂无帐号"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="点击下方“新增”创建第一个 R2 帐号"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 底部操作 -->
                    <StackPanel Grid.Row="2" Margin="12,10,12,14">
                        <UniformGrid Columns="3" Margin="0,0,0,8">
                            <Button x:Name="BtnAddAccount" Style="{DynamicResource BtnIcon}" Content="&#xE710;"
                                    ToolTip="添加帐号" Click="BtnAddAccount_Click" />
                            <Button x:Name="BtnEditAccount" Style="{DynamicResource BtnIcon}" Content="&#xE70F;"
                                    ToolTip="编辑帐号" Click="BtnEditAccount_Click" />
                            <Button x:Name="BtnDeleteAccount" Style="{DynamicResource BtnIcon}" Content="&#xE74D;"
                                    ToolTip="删除帐号" Click="BtnDeleteAccount_Click" />
                        </UniformGrid>
                        <Button x:Name="BtnConnect" Style="{DynamicResource BtnPrimary}" Content="连接"
                                Click="BtnConnect_Click" />
                        <Button x:Name="BtnSettings" Style="{DynamicResource BtnGhost}" Content="设置"
                                Margin="0,8,0,0" Click="BtnSettings_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- ============ 右侧：文件管理 ============ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="168" />
                </Grid.RowDefinitions>

                <!-- 工具栏 1：存储桶 + 路径 -->
                <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource BorderStrokeBrush}" BorderThickness="0,0,0,1"
                        Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="存储桶" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox x:Name="BucketCombo" Width="190" Margin="8,0"
                                      SelectionChanged="BucketCombo_SelectionChanged" />
                            <Button x:Name="BtnRefreshBuckets" Style="{DynamicResource BtnIcon}" Content="&#xE72C;"
                                    ToolTip="刷新存储桶" Click="BtnRefreshBuckets_Click" />
                            <Button x:Name="BtnCreateBucket" Style="{DynamicResource BtnIcon}" Content="&#xE8B7;"
                                    ToolTip="新建存储桶" Click="BtnCreateBucket_Click" />
                            <Button x:Name="BtnDeleteBucket" Style="{DynamicResource BtnIcon}" Content="&#xE74D;"
                                    ToolTip="删除当前存储桶（会先清空其中对象）" Click="BtnDeleteBucket_Click" />
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathBox" VerticalContentAlignment="Center"
                                     PreviewKeyDown="PathBox_KeyDown" ToolTip="路径前缀，回车跳转，如 folder/sub" />
                            <Button Grid.Column="1" Style="{DynamicResource BtnIcon}" Content="&#xE72C;"
                                    Margin="6,0,0,0" ToolTip="跳转" Click="BtnGoPath_Click" />
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="BtnUp" Style="{DynamicResource BtnIcon}" Content="&#xE74A;"
                                    ToolTip="返回上级" Click="BtnUp_Click" />
                            <Button x:Name="BtnNewFolder" Style="{DynamicResource BtnIcon}" Content="&#xE8B7;"
                                    ToolTip="新建文件夹" Click="BtnNewFolder_Click" />
                            <Button x:Name="BtnUpload" Style="{DynamicResource BtnIcon}" Content="&#xE898;"
                                    ToolTip="上传文件 / 文件夹" Click="BtnUpload_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="上传文件..." Click="CtxUploadFiles_Click" />
                                        <MenuItem Header="上传文件夹..." Click="CtxUploadFolder_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button x:Name="BtnRefresh" Style="{DynamicResource BtnIcon}" Content="&#xE72C;"
                                    ToolTip="刷新" Click="BtnRefresh_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 工具栏 2：对象操作 -->
                <Border Grid.Row="1" Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource BorderStrokeBrush}" BorderThickness="0,0,0,1"
                        Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="BtnDownload" Style="{DynamicResource ToolButton}" Click="BtnDownload_Click"
                                    ToolTip="下载到本地">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="下载" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnOpen" Style="{DynamicResource ToolButton}" Click="BtnOpen_Click"
                                    ToolTip="下载到临时目录并用默认程序打开" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="打开" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCopyUrl" Style="{DynamicResource ToolButton}" Click="BtnCopyUrl_Click"
                                    ToolTip="复制对象公开地址" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="复制URL" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnPresigned" Style="{DynamicResource ToolButton}" Click="BtnPresigned_Click"
                                    ToolTip="生成临时访问链接" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="临时链接" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCut" Style="{DynamicResource ToolButton}" Click="BtnCut_Click"
                                    ToolTip="剪切（粘贴时移动）" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="剪切" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCopy" Style="{DynamicResource ToolButton}" Click="BtnCopy_Click"
                                    ToolTip="复制（粘贴时保留原文件）" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="复制" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnPaste" Style="{DynamicResource ToolButton}" Click="BtnPaste_Click"
                                    ToolTip="粘贴到当前目录" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="粘贴" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnRename" Style="{DynamicResource ToolButton}" Click="BtnRename_Click"
                                    ToolTip="重命名" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="重命名" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnDelete" Style="{DynamicResource ToolButton}" Click="BtnDelete_Click"
                                    ToolTip="删除选中项" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource DangerBrush}" />
                                    <TextBlock Text="删除" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <Border Background="{DynamicResource InputBgBrush}"
                                    BorderBrush="{DynamicResource BorderStrokeBrush}" BorderThickness="1"
                                    CornerRadius="6" Width="200" Height="30">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="8,0,4,0" />
                                    <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0"
                                             Background="Transparent" Padding="2,0" VerticalContentAlignment="Center"
                                             TextChanged="SearchBox_TextChanged" ToolTip="按名称筛选当前目录" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内容区 -->
                <Grid Grid.Row="2">
                    <DataGrid x:Name="ObjectGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="True"
                              CanUserResizeRows="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              RowHeight="36"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              AllowDrop="True"
                              Drop="ObjectGrid_Drop"
                              DragOver="ObjectGrid_DragOver"
                              PreviewMouseRightButtonDown="ObjectGrid_PreviewRightButtonDown"
                              MouseDoubleClick="ObjectGrid_MouseDoubleClick"
                              PreviewKeyDown="ObjectGrid_PreviewKeyDown"
                              SelectionChanged="ObjectGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="名称" Width="*"
                                                    CellTemplate="{StaticResource NameCellTemplate}" />
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay}" Width="110" />
                            <DataGridTextColumn Header="修改时间" Binding="{Binding ModifiedDisplay}" Width="170" />
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplay}" Width="90" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="下载" Click="CtxDownload_Click" />
                                <MenuItem Header="用默认程序打开" Click="CtxOpen_Click" />
                                <Separator />
                                <MenuItem Header="复制 URL（公开地址）" Click="CtxCopyUrl_Click" />
                                <MenuItem Header="生成临时链接" Click="CtxPresigned_Click" />
                                <Separator />
                                <MenuItem Header="剪切" Click="CtxCut_Click" />
                                <MenuItem Header="复制" Click="CtxCopy_Click" />
                                <MenuItem Header="粘贴到此处" Click="CtxPaste_Click" />
                                <Separator />
                                <MenuItem Header="重命名" Click="CtxRename_Click" />
                                <MenuItem Header="属性" Click="CtxProperties_Click" />
                                <Separator />
                                <MenuItem Header="删除" Click="CtxDelete_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <!-- 空状态 -->
                    <Border x:Name="EmptyOverlay" Background="{DynamicResource PanelBgBrush}"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyOverlayText" Text="请在左侧选择帐号并连接"
                                       FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,10,0,0" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyOverlayHint" Text="也可以拖拽本地文件到窗口进行上传"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 加载中遮罩 -->
                    <Border x:Name="LoadingOverlay" Background="#66000000" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="正在加载..." FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="#FFF38020" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 传输队列 -->
                <Border Grid.Row="3" Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource BorderStrokeBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                <TextBlock Text="传输队列" FontWeight="SemiBold" />
                                <TextBlock x:Name="TransferSummary" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="12,2,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <ProgressBar x:Name="TransferProgressBar" Width="220" Height="6" VerticalAlignment="Center" />
                                <Button x:Name="BtnClearTransfers" Content="清除已完成" Style="{DynamicResource BtnGhost}"
                                        FontSize="12" Margin="10,0,0,0" Click="BtnClearTransfers_Click" />
                            </StackPanel>
                        </Grid>

                        <ListView x:Name="TransferList" Grid.Row="1" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Operation}" FontSize="12"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding TransferredDisplay}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="3" Value="{Binding Progress}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding StateText}" FontSize="12"
                                                   Foreground="{Binding State, Converter={StaticResource TransferStateColor}}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="5" Content="&#xE711;" Style="{DynamicResource BtnIcon}"
                                                Width="24" Height="24" FontSize="11" Click="BtnCancelTransfer_Click"
                                                Tag="{Binding}" ToolTip="取消" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="1" Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource BorderStrokeBrush}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" x:Name="SelectedText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Ellipse x:Name="ConnDot" Width="8" Height="8"
                             Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ConnText" Text="未连接" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
