<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题（App.xaml 中该字典固定位于 MergedDictionaries 索引 0，用于运行时切换） -->
    <!-- 颜色 -->
    <Color x:Key="WindowBg">#F3F4F7</Color>
    <Color x:Key="SidebarBg">#FFFFFF</Color>
    <Color x:Key="PanelBg">#FFFFFF</Color>
    <Color x:Key="PanelAltBg">#EFF1F5</Color>
    <Color x:Key="InputBg">#FFFFFF</Color>
    <Color x:Key="HoverBg">#E9EDF3</Color>
    <Color x:Key="SelectionBg">#FDEBD8</Color>
    <Color x:Key="SelectionBorder">#F38020</Color>
    <Color x:Key="BorderStroke">#DCE1E8</Color>
    <Color x:Key="Accent">#F38020</Color>
    <Color x:Key="AccentHover">#E67612</Color>
    <Color x:Key="AccentDim">#FBE4D2</Color>
    <Color x:Key="TextPrimary">#1B2229</Color>
    <Color x:Key="TextSecondary">#6A7481</Color>
    <Color x:Key="TextOnAccent">#FFFFFF</Color>
    <Color x:Key="Danger">#D33B33</Color>
    <Color x:Key="Success">#2E9E44</Color>
    <Color x:Key="Warning">#A97B12</Color>
    <Color x:Key="ThumbBg">#C5CBD4</Color>
    <Color x:Key="OverlayHover">#0A000000</Color>
    <Color x:Key="OverlayPressed">#18000000</Color>
    <Color x:Key="SelectionOverlay">#14F38020</Color>

    <!-- 画刷 -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBg}" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBg}" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBg}" />
    <SolidColorBrush x:Key="PanelAltBgBrush" Color="{StaticResource PanelAltBg}" />
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBg}" />
    <SolidColorBrush x:Key="HoverBgBrush" Color="{StaticResource HoverBg}" />
    <SolidColorBrush x:Key="SelectionBgBrush" Color="{StaticResource SelectionBg}" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="{StaticResource SelectionBorder}" />
    <SolidColorBrush x:Key="BorderStrokeBrush" Color="{StaticResource BorderStroke}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDim}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccent}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{StaticResource ThumbBg}" />
    <SolidColorBrush x:Key="OverlayHoverBrush" Color="{StaticResource OverlayHover}" />
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="{StaticResource OverlayPressed}" />
    <SolidColorBrush x:Key="SelectionOverlayBrush" Color="{StaticResource SelectionOverlay}" />

</ResourceDictionary>
