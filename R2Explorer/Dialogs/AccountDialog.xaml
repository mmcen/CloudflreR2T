<Window x:Class="R2Explorer.Dialogs.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帐号设置"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
        <StackPanel Margin="24,20,24,22">

            <!-- 基本信息 -->
            <TextBlock Text="基本信息" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="帐号名称 *" Margin="0,0,0,5" />
                    <TextBox x:Name="TxtName" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="登录模式 *" Margin="0,0,0,5" />
                    <ComboBox x:Name="ModeCombo" SelectionChanged="ModeCombo_SelectionChanged">
                        <ComboBoxItem Tag="r2-token" Content="R2 S3 API Token（推荐）" />
                        <ComboBoxItem Tag="r2-api-token" Content="R2 API Token（自动换取临时凭证）" />
                        <ComboBoxItem Tag="r2-global-key" Content="Cloudflare 全局 API Key" />
                        <ComboBoxItem Tag="s3-custom" Content="自定义 S3 兼容端点" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- 连接信息 -->
            <TextBlock Text="连接信息" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,20,0,10" />

            <StackPanel x:Name="RowAccountId">
                <TextBlock Text="Cloudflare 帐号 ID（Account ID）*" Margin="0,0,0,5" />
                <TextBox x:Name="TxtAccountId" />
                <TextBlock Text="可在 Cloudflare 仪表盘右侧边栏找到。用于构成 S3 端点：https://&lt;account_id&gt;.r2.cloudflarestorage.com"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="RowEndpoint" Visibility="Collapsed">
                <TextBlock Text="端点地址（Endpoint URL）*" Margin="0,0,0,5" />
                <TextBox x:Name="TxtEndpoint" Text="https://s3.example.com" />
                <TextBlock Text="任意 S3 兼容服务端点，如 MinIO、AWS S3、阿里云 OSS 等。"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10" />
            </StackPanel>

            <Grid x:Name="RowAccess">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Access Key ID *" Margin="0,0,0,5" />
                    <TextBox x:Name="TxtAccessKey" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Secret Access Key *" Margin="0,0,0,5" />
                    <PasswordBox x:Name="TxtSecret" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="RowApiToken" Visibility="Collapsed">
                <TextBlock Text="R2 API Token *" Margin="0,10,0,5" />
                <PasswordBox x:Name="TxtApiToken" />
                <TextBlock Text="在 Cloudflare 仪表盘：我的个人资料 → API 令牌 → 创建令牌，选择“编辑 Cloudflare Workers”或自定义令牌并授予 R2 权限。"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <Grid x:Name="RowGlobal" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="注册邮箱（Email）*" Margin="0,10,0,5" />
                    <TextBox x:Name="TxtEmail" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Global API Key *" Margin="0,10,0,5" />
                    <PasswordBox x:Name="TxtGlobalKey" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="RowRegion" Visibility="Collapsed">
                <TextBlock Text="区域（Region）" Margin="0,10,0,5" />
                <TextBox x:Name="TxtRegion" ToolTip="可留空。某些 S3 兼容服务要求指定区域，如 ap-southeast-1" />
            </StackPanel>

            <CheckBox x:Name="ChkForcePathStyle" Content="使用 Path-Style 访问（一般保持勾选）"
                      IsChecked="True" Visibility="Collapsed" Margin="0,12,0,0" />

            <StackPanel x:Name="RowPublicUrl">
                <TextBlock Text="公开访问地址（可选）" Margin="0,14,0,5" />
                <TextBox x:Name="TxtPublicBase" ToolTip="例如 https://pub-xxxxxxxx.r2.dev 或自定义域名" />
                <TextBlock Text="配置后，“复制 URL”会生成公开链接；留空则自动改用临时链接。"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="BtnTest" Content="测试连接" Style="{DynamicResource BtnBase}" Click="BtnTest_Click" />
                <Button x:Name="BtnSave" Content="保存" Style="{DynamicResource BtnPrimary}" IsDefault="True" Margin="10,0,0,0" Click="BtnSave_Click" />
                <Button Content="取消" Style="{DynamicResource BtnBase}" IsCancel="True" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock x:Name="TestResult" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
