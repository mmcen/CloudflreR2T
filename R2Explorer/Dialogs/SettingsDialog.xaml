<Window x:Class="R2Explorer.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="660">
        <StackPanel Margin="24,20,24,22">

            <!-- 代理 -->
            <TextBlock Text="代理设置（用于加速 R2 访问）" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="可配置 HTTP / HTTPS / SOCKS5 代理。所有 S3 请求与 Cloudflare API 请求都会经过该代理。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10" TextWrapping="Wrap" />

            <CheckBox x:Name="ChkProxyEnabled" Content="启用代理" Checked="Proxy_Changed" Unchecked="Proxy_Changed" />
            <Grid Margin="0,10,0,0" x:Name="ProxyFields">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="协议" Margin="0,0,0,5" />
                    <ComboBox x:Name="ProxyTypeCombo">
                        <ComboBoxItem Tag="http" Content="HTTP" />
                        <ComboBoxItem Tag="https" Content="HTTPS" />
                        <ComboBoxItem Tag="socks5" Content="SOCKS5" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="服务器地址" Margin="0,0,0,5" />
                    <TextBox x:Name="TxtProxyHost" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="端口" Margin="0,0,0,5" />
                    <TextBox x:Name="TxtProxyPort" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="用户名（可选）" Margin="0,0,0,5" />
                            <TextBox x:Name="TxtProxyUser" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="密码（可选）" Margin="0,0,0,5" />
                            <PasswordBox x:Name="TxtProxyPass" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="BtnTestProxy" Content="测试代理连接" Style="{DynamicResource BtnBase}" Click="BtnTestProxy_Click" />
            </StackPanel>
            <TextBlock x:Name="ProxyTestResult" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />

            <!-- 窗口与托盘 -->
            <TextBlock Text="窗口与托盘" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,22,0,10" />
            <CheckBox x:Name="ChkTrayOnClose" Content="点击关闭按钮时最小化到系统托盘" Margin="0,0,0,8" />
            <CheckBox x:Name="ChkTrayOnMinimize" Content="最小化窗口时隐藏到系统托盘" Margin="0,0,0,8" />
            <CheckBox x:Name="ChkAutoConnect" Content="启动时自动连接上次使用的帐号" />

            <!-- 传输 -->
            <TextBlock Text="传输" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,22,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="最大并发传输数" Margin="0,0,0,5" />
                    <TextBox x:Name="TxtConcurrency" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="界面主题" Margin="0,0,0,5" />
                    <ComboBox x:Name="ThemeCombo">
                        <ComboBoxItem Tag="Dark" Content="深色" />
                        <ComboBoxItem Tag="Light" Content="浅色" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="ChkConfirmDelete" Content="删除文件/文件夹前弹出确认" Margin="0,12,0,0" />

            <!-- 操作 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="保存" Style="{DynamicResource BtnPrimary}" IsDefault="True" Click="BtnSave_Click" />
                <Button Content="取消" Style="{DynamicResource BtnBase}" IsCancel="True" Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
